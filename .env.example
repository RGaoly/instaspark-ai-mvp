# ──────────────────────────────────────────────────────────────
# InstaSpark AI — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# All values have sensible defaults; only override what you need.
# ──────────────────────────────────────────────────────────────

# ─── Application ───
APP_NAME=InstaSpark AI
DEFAULT_LANGUAGE=en

# ─── Database ───
# Relative to project root
DATABASE_PATH=data/instaspark.db
SQLITE_JOURNAL_MODE=WAL

# ─── Authentication ───
# PBKDF2 password hashing parameters
PBKDF2_ITERATIONS=260000
PBKDF2_HASH_ALGORITHM=sha256
SALT_LENGTH=16

# Default admin user (created on first run if users table is empty)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_DISPLAY_NAME=Olivia Chen

# Default demo/viewer user
DEFAULT_DEMO_USERNAME=demo
DEFAULT_DEMO_PASSWORD=demo123
DEFAULT_DEMO_DISPLAY_NAME=Demo Viewer

# ─── Data File Paths ───
# Relative to project root
CREATORS_DATA_PATH=data/creators.csv
MISSION_DATA_PATH=data/launch_mission.json
OPPORTUNITIES_DATA_PATH=data/creator_opportunities.json

# ─── Scoring Weights ───
# Mix drivers must sum to 1.0. Rule-based, not LLM / embeddings.
# Query boost (cap +4) and live-proof bonus (cap +3) are additive, not mix weights.
SCORE_WEIGHT_MISSION_FIT=0.20
SCORE_WEIGHT_TOPIC_OVERLAP=0.30
SCORE_WEIGHT_MOMENTUM=0.15
SCORE_WEIGHT_COMMERCIAL_FIT=0.15
SCORE_WEIGHT_BRAND_SAFETY=0.20
# Legacy aliases SCORE_WEIGHT_CONTENT_FIT / SCORE_WEIGHT_AUDIENCE_FIT still map
# onto topic_overlap / mission_fit when the names above are unset.

# ─── Opportunity Thresholds ───
# Score below this triggers human review
OPPORTUNITY_HUMAN_REVIEW_THRESHOLD=70
# Score at or above this qualifies for active missions
OPPORTUNITY_QUALIFIED_THRESHOLD=75
# Score below this is considered low confidence
OPPORTUNITY_LOW_CONFIDENCE_THRESHOLD=60

# ─── External Services ───
# LLM provider — supports any OpenAI-compatible API
# DeepSeek (default, low cost): https://api.deepseek.com, model: deepseek-chat
# OpenAI: https://api.openai.com/v1, model: gpt-4o-mini
# Moonshot: https://api.moonshot.cn/v1, model: moonshot-v1-8k
# Leave empty to keep Content Studio on the deterministic mock.
# Streamlit Cloud: optional LLM_API_KEY / LLM_BASE_URL / LLM_MODEL in App settings → Secrets.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# Feishu / Lark integration (optional)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional public YouTube Data API v3 key for Creator Search live lookup.
# Ranking still uses the synthetic catalog; live hits are labeled evidence only.
# Streamlit Cloud: paste the same names in App settings → Secrets as TOML.
# Never commit a real key.
YOUTUBE_API_KEY=
YOUTUBE_API_TIMEOUT_SECONDS=8
